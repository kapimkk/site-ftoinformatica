# Variáveis públicas da empresa.
# O prefixo VITE_ faz o Vite embutir o valor no JavaScript do navegador.
# Use somente informações que podem aparecer no site.
# Não coloque senha, token, chave de API ou qualquer segredo.

# Nome exibido no cabeçalho, nos textos e no título da página.
VITE_COMPANY_NAME="FTO Informática"

# Telefone com DDI e DDD, apenas números. Exemplo Brasil: 5511999999999
VITE_COMPANY_PHONE=""

# WhatsApp com DDI e DDD, apenas números. Exemplo Brasil: 5511999999999
VITE_COMPANY_WHATSAPP=""

# E-mail público de contato.
VITE_COMPANY_EMAIL=""

# Endereço público. Pode ocupar mais de uma linha entre aspas.
VITE_COMPANY_ADDRESS=""

# Cidade publicada junto do endereço.
VITE_COMPANY_CITY=""

# Perfil ou URL completa. Exemplos: @ftoinformatica ou https://instagram.com/ftoinformatica
VITE_COMPANY_INSTAGRAM=""

# Página ou URL completa. Exemplos: ftoinformatica ou https://facebook.com/ftoinformatica
VITE_COMPANY_FACEBOOK=""

# Horário em texto livre. Exemplo: Segunda a sexta, 9h às 18h
VITE_COMPANY_BUSINESS_HOURS=""

# Link https de Google Maps (google.com, goo.gl ou maps.app.goo.gl).
VITE_GOOGLE_MAPS_URL=""
